{
  "info": {
    "name": "Lab2 FSI2026 - Reglas de credito (Drools)",
    "description": "Pruebas de las 6 reglas de credito definidas en credit_rules.drl. Endpoint REST: POST /credit/api/evaluate",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Test 1 - RejectLowCreditScore",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": {\n    \"name\": \"Ana Gomez\",\n    \"age\": 25,\n    \"monthlyIncome\": 2000.0,\n    \"creditScore\": 450\n  },\n  \"creditType\": \"personal\",\n  \"requestAmount\": 10000.0\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/credit/api/evaluate",
          "host": ["{{baseUrl}}"],
          "path": ["credit", "api", "evaluate"]
        }
      },
      "response": []
    },
