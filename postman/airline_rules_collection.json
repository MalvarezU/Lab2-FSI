{
  "info": {
    "name": "Lab2 FSI2026 - Reglas de aerolinea (Drools)",
    "description": "Pruebas de las 10 reglas de negocio de la aerolineaa definidas en airline_rules.drl. Endpoint REST: POST /airline/api/evaluate",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Regla 1 - UpgradeToBusinessClassForFrequentFlyersWithDelays",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passenger\": { \"name\": \"Ana\", \"age\": 35, \"membershipTier\": \"Gold\", \"travellingWithChildren\": false },\n  \"flight\": { \"flightNumber\": \"AV101\", \"delayMinutes\": 90, \"durationHours\": 3.0, \"emergencyExitSeatsAvailable\": 0 },\n  \"luggageWeightKg\": 12.0,\n  \"seatPreference\": \"Window\",\n  \"basePrice\": 500.0\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/airline/api/evaluate", "host": ["{{baseUrl}}"], "path": ["airline", "api", "evaluate"] }
      },
      "response": []
    },
